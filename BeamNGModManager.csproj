<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<Version>1.3.0</Version>
		<AssemblyName>BeamNGModManager</AssemblyName>

		<!-- РРєРѕРЅРєР° СЃР°РјРѕРіРѕ .exe С„Р°Р№Р»Р° РІ РџСЂРѕРІРѕРґРЅРёРєРµ Рё РЅР° Р Р°Р±РѕС‡РµРј СЃС‚РѕР»Рµ -->
		<ApplicationIcon>icon.ico</ApplicationIcon>

		<!-- РџР°СЂР°РјРµС‚СЂС‹ СЃР±РѕСЂРєРё РІ РѕРґРёРЅ РїРѕСЂС‚Р°С‚РёРІРЅС‹Р№ .exe С„Р°Р№Р» -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SharpCompress" Version="0.38.0" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="locales.json" />
		<!-- Р’С€РёРІР°РµРј РёРєРѕРЅРєСѓ РІ СЂРµСЃСѓСЂСЃС‹ РѕРєРЅР° WPF -->
		<Resource Include="icon.ico" />
	</ItemGroup>

</Project>
