<Window x:Class="BeamNGModManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeamNG.drive Mod Manager" Height="760" Width="1180"
        MinHeight="600" MinWidth="960"
        Icon="pack://application:,,,/icon.ico"
        Background="{StaticResource BgDark}" Foreground="{StaticResource TextPrimary}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя карточка: Брендинг, Профили и Язык -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип и название -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Image Source="pack://application:,,,/icon.ico" Width="32" Height="32"
                           VerticalAlignment="Center" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BeamNG.drive" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="MOD MANAGER" FontWeight="Bold" FontSize="10" Foreground="{StaticResource AccentOrange}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="LblProfile" Grid.Column="1" Text="Профиль:" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" Margin="0,0,10,0"/>

                <!-- Красивый выпадающий список профилей с бейджем количества модов и обрезкой длинного пути -->
                <ComboBox x:Name="CmbProfiles" Grid.Column="2" Height="36" VerticalContentAlignment="Center"
                          FontSize="13" Margin="0,0,10,0" SelectionChanged="CmbProfiles_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ShortTitle}" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Grid.Column="1" Background="#323240" CornerRadius="4" Padding="6,2" Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ModsCountBadge}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#FF9838"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding ModsPath}" FontSize="12"
                                           Foreground="#A1A1B5" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button x:Name="BtnAddProfile" Grid.Column="3" Content="Добавить профиль"
                        Style="{StaticResource ModernButton}" Margin="0,0,8,0" Click="BtnAddProfile_Click"/>

                <Button x:Name="BtnAutoDetect" Grid.Column="4" Content="Автопоиск путей"
                        Style="{StaticResource ModernButton}" Margin="0,0,12,0" Click="BtnAutoDetect_Click"/>

                <ComboBox x:Name="CmbLanguage" Grid.Column="5" Width="76" Height="36"
                          VerticalContentAlignment="Center" FontWeight="Bold"
                          SelectionChanged="CmbLanguage_SelectionChanged"/>
            </Grid>
        </Border>

        <!-- Панель действий: Установка, Поиск, Фильтр, Тумблер Hardlinks -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnInstallMods" Grid.Column="0" Content="＋ Установить моды (.zip/.rar/.7z)"
                    Style="{StaticResource PrimaryOrangeButton}" Padding="18,10" Click="BtnInstallMods_Click"/>

            <TextBox x:Name="TxtSearch" Grid.Column="1" Style="{StaticResource DarkTextBox}"
                     Margin="14,0" Height="38" TextChanged="TxtSearch_TextChanged"/>

            <ComboBox x:Name="CmbFilter" Grid.Column="2" Width="175" Height="38" VerticalContentAlignment="Center"
                      FontSize="13" SelectionChanged="CmbFilter_SelectionChanged" Margin="0,0,16,0">
                <ComboBoxItem x:Name="FilterAll" Content="Все моды" IsSelected="True"/>
                <ComboBoxItem x:Name="FilterActive" Content="Только активные"/>
                <ComboBoxItem x:Name="FilterDisabled" Content="Отключённые"/>
            </ComboBox>

            <CheckBox x:Name="ChkHardlinks" Grid.Column="3" Content="Hardlinks"
                      Style="{StaticResource ToggleSwitchStyle}"
                      VerticalAlignment="Center" Checked="ChkHardlinks_Changed" Unchecked="ChkHardlinks_Changed"/>
        </Grid>

        <!-- Карточка со списком модов -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <DataGrid x:Name="GridMods" AutoGenerateColumns="False" CanUserAddRows="False"
                      Background="Transparent" AlternatingRowBackground="#202028"
                      Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#292933"
                      HeadersVisibility="Column" RowHeight="50" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="ColActive" Header="Вкл" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Click="ModCheckBox_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="" Width="68">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="52" Height="36" CornerRadius="6" Background="#2A2A35" ClipToBounds="True">
                                    <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn x:Name="ColName" Header="Название мода" Binding="{Binding DisplayName}"
                                        Width="2.2*" IsReadOnly="True" FontWeight="SemiBold" FontSize="13"/>

                    <DataGridTextColumn x:Name="ColAuthor" Header="Автор" Binding="{Binding Author}"
                                        Width="1.1*" IsReadOnly="True" Foreground="{StaticResource TextSecondary}"/>

                    <DataGridTextColumn x:Name="ColVersion" Header="Версия" Binding="{Binding Version}"
                                        Width="95" IsReadOnly="True" Foreground="{StaticResource AccentOrange}" FontWeight="SemiBold"/>

                    <DataGridTextColumn x:Name="ColFile" Header="Файл" Binding="{Binding FileName}"
                                        Width="1.5*" IsReadOnly="True" Foreground="{StaticResource TextSecondary}"/>

                    <DataGridTextColumn x:Name="ColSize" Header="Размер" Binding="{Binding SizeFormatted}"
                                        Width="95" IsReadOnly="True" Foreground="{StaticResource TextSecondary}"/>

                    <DataGridTemplateColumn Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" Style="{StaticResource DangerIconButton}"
                                        HorizontalAlignment="Center" Click="BtnDeleteMod_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Нижняя панель обслуживания и запуска игры -->
        <Border Grid.Row="3" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnClearCache" Grid.Column="0" Content="Очистить кэш (без шейдеров)"
                        Style="{StaticResource ModernButton}" Margin="0,0,8,0" Click="BtnClearCache_Click"/>

                <Button x:Name="BtnCheckConflicts" Grid.Column="1" Content="Проверить конфликты"
                        Style="{StaticResource ModernButton}" Margin="0,0,8,0" Click="BtnCheckConflicts_Click"/>

                <Button x:Name="BtnCheckUpdates" Grid.Column="2" Content="Обновления"
                        Style="{StaticResource ModernButton}" Click="BtnCheckUpdates_Click"/>

                <TextBlock x:Name="LblStatus" Grid.Column="3"
                           Text="Перетащите архивы (.zip, .rar, .7z) в любое место окна"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                           Margin="18,0" TextTrimming="CharacterEllipsis"/>

                <Button x:Name="BtnLaunchGame" Grid.Column="4" Content="Запустить BeamNG.drive"
                        Style="{StaticResource LaunchGreenButton}" Padding="22,10" Click="BtnLaunchGame_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>