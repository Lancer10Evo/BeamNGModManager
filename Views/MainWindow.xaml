<Window x:Class="BeamNGModManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeamNG.drive Mod Manager" Height="840" Width="1360"
        MinHeight="700" MinWidth="1100"
        Icon="pack://application:,,,/icon.ico"
        Background="{StaticResource BgDark}" Foreground="{StaticResource TextPrimary}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- РЯД 0: Верхняя шапка -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Image Source="pack://application:,,,/icon.ico" Width="34" Height="34"
                           VerticalAlignment="Center" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BeamNG &amp; BeamMP" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="MOD MANAGER PRO v2.0" FontWeight="Bold" FontSize="10" Foreground="{StaticResource AccentOrange}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="LblProfile" Grid.Column="1" Text="Профиль:" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" Margin="0,0,8,0"/>

                <ComboBox x:Name="CmbProfiles" Grid.Column="2" Height="36" VerticalContentAlignment="Center"
                          FontSize="13" Margin="0,0,8,0" SelectionChanged="CmbProfiles_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ShortTitle}" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Grid.Column="1" Background="#323240" CornerRadius="4" Padding="6,2" Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ModsCountBadge}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#FF9838"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding ModsPath}" FontSize="12"
                                           Foreground="#A1A1B5" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="3" Content="📂 Папка" Style="{StaticResource ModernButton}"
                        Margin="0,0,6,0" Click="BtnOpenFolder_Click"/>

                <Button x:Name="BtnAddProfile" Grid.Column="4" Content="Добавить профиль"
                        Style="{StaticResource ModernButton}" Margin="0,0,6,0" Click="BtnAddProfile_Click"/>

                <Button x:Name="BtnAutoDetect" Grid.Column="5" Content="Автопоиск"
                        Style="{StaticResource ModernButton}" Margin="0,0,6,0" Click="BtnAutoDetect_Click"/>

                <Button Grid.Column="6" Content="🛡️ Лицензия" Style="{StaticResource ModernButton}"
                        Margin="0,0,10,0" ToolTip="Диагностика и симулятор Steam / Epic Games" Click="BtnTestLicense_Click"/>

                <ComboBox x:Name="CmbLanguage" Grid.Column="7" Width="72" Height="36"
                          VerticalContentAlignment="Center" FontWeight="Bold"
                          SelectionChanged="CmbLanguage_SelectionChanged"/>
            </Grid>
        </Border>

        <!-- РЯД 1: Дашборд + Именные Loadouts -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*"/>
                <ColumnDefinition Width="0.85*"/>
                <ColumnDefinition Width="0.85*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="3.1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="ВСЕГО МОДОВ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="TxtStatTotal" Text="0" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="АКТИВНО" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                    <TextBlock x:Name="TxtStatActive" Text="0" FontSize="19" FontWeight="Bold" Foreground="#10B981"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="ОТКЛЮЧЕНО" FontSize="10" FontWeight="Bold" Foreground="#F59E0B"/>
                    <TextBlock x:Name="TxtStatDisabled" Text="0" FontSize="19" FontWeight="Bold" Foreground="#F59E0B"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="ОБЩИЙ ВЕС" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentOrange}"/>
                    <TextBlock x:Name="TxtStatSize" Text="0 MB" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="10" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="CmbPresets" Grid.Column="0" Height="34" VerticalContentAlignment="Center"
                              Margin="0,0,6,0" SelectionChanged="CmbPresets_SelectionChanged"/>

                    <TextBox x:Name="TxtPresetName" Grid.Column="1" Background="#26262F" Foreground="White"
                             BorderBrush="#32323E" BorderThickness="1" Padding="8,0" Height="34"
                             VerticalContentAlignment="Center" Margin="0,0,6,0"
                             Text="Моя сборка"/>

                    <Button Grid.Column="2" Content="💾 Сохранить" Style="{StaticResource ModernButton}"
                            Padding="10,6" Margin="0,0,6,0" Click="BtnSavePreset_Click"/>

                    <Button Grid.Column="3" Content="🗑️" Style="{StaticResource DangerIconButton}"
                            Padding="10,6" Margin="0,0,6,0" Click="BtnDeletePreset_Click"/>

                    <Button Grid.Column="4" Content="🌐 Режим MP" Style="{StaticResource ModernButton}"
                            Background="#1E293B" BorderBrush="#3B82F6" Foreground="#60A5FA"
                            Padding="10,6" Click="BtnBeamMpOnlyMode_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- РЯД 2: Установка с ПК, Мод-Хаб 2.0, Поиск и Фильтры -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnInstallMods" Grid.Column="0" Content="＋ Файл с ПК"
                    Style="{StaticResource PrimaryOrangeButton}" Padding="16,10" Margin="0,0,8,0" Click="BtnInstallMods_Click"/>

            <Button Grid.Column="1" Content="🌐 Мод-Хаб 2.0 (BeamNG / ModLand / PG / Nexus)"
                    Style="{StaticResource ModernButton}" Background="#1E293B" BorderBrush="#3B82F6" Foreground="#60A5FA"
                    FontWeight="Bold" Padding="14,10" Click="BtnOpenModHub_Click"/>

            <TextBox x:Name="TxtSearch" Grid.Column="2" Style="{StaticResource DarkTextBox}"
                     Margin="12,0" Height="38" TextChanged="TxtSearch_TextChanged"/>

            <Button Grid.Column="3" Content="✅ Вкл все" Style="{StaticResource ModernButton}"
                    Margin="0,0,6,0" Click="BtnEnableAll_Click"/>

            <Button Grid.Column="4" Content="⛔ Выкл все" Style="{StaticResource ModernButton}"
                    Margin="0,0,10,0" Click="BtnDisableAll_Click"/>

            <ComboBox x:Name="CmbFilter" Grid.Column="5" Width="185" Height="38" VerticalContentAlignment="Center"
                      FontSize="13" SelectionChanged="CmbFilter_SelectionChanged" Margin="0,0,14,0">
                <ComboBoxItem x:Name="FilterAll" Content="Все моды" IsSelected="True"/>
                <ComboBoxItem x:Name="FilterActive" Content="Только активные"/>
                <ComboBoxItem x:Name="FilterDisabled" Content="Отключённые"/>
                <ComboBoxItem Content="★ Избранное"/>
                <ComboBoxItem Content="🌐 Только BeamMP"/>
                <ComboBoxItem Content="🚗 Только Авто"/>
                <ComboBoxItem Content="🗺️ Только Карты"/>
                <ComboBoxItem Content="⚙️ Только Скрипты"/>
            </ComboBox>

            <CheckBox x:Name="ChkHardlinks" Grid.Column="6" Content="Hardlinks"
                      Style="{StaticResource ToggleSwitchStyle}"
                      VerticalAlignment="Center" Checked="ChkHardlinks_Changed" Unchecked="ChkHardlinks_Changed"/>
        </Grid>

        <!-- РЯД 3: Таблица модов + Инспектор Мода -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- Таблица модов -->
            <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="12" ClipToBounds="True" Margin="0,0,12,0">
                <DataGrid x:Name="GridMods" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="Transparent" AlternatingRowBackground="#202028"
                          Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#292933"
                          HeadersVisibility="Column" RowHeight="50" SelectionMode="Single"
                          SelectionChanged="GridMods_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="★" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding FavoriteStar}" Background="Transparent" BorderThickness="0"
                                            Foreground="#FBBF24" FontSize="18" Cursor="Hand"
                                            HorizontalAlignment="Center" Click="BtnFavoriteMod_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="ColActive" Header="Вкл" Width="64">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Click="ModCheckBox_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="64">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="50" Height="34" CornerRadius="6" Background="#2A2A35">
                                        <Border CornerRadius="6">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding PreviewImage}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Тип" Binding="{Binding Category}" Width="92" IsReadOnly="True" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Источник" Binding="{Binding SourceTag}" Width="92" IsReadOnly="True" Foreground="#60A5FA" FontWeight="SemiBold"/>
                        <DataGridTextColumn x:Name="ColName" Header="Название мода" Binding="{Binding DisplayName}" Width="2*" IsReadOnly="True" FontWeight="SemiBold" FontSize="13"/>
                        <DataGridTextColumn x:Name="ColAuthor" Header="Автор" Binding="{Binding Author}" Width="1*" IsReadOnly="True" Foreground="{StaticResource TextSecondary}"/>
                        <DataGridTextColumn x:Name="ColVersion" Header="Версия" Binding="{Binding Version}" Width="80" IsReadOnly="True" Foreground="{StaticResource AccentOrange}" FontWeight="SemiBold"/>
                        <DataGridTextColumn x:Name="ColSize" Header="Размер" Binding="{Binding SizeFormatted}" Width="88" IsReadOnly="True" Foreground="{StaticResource TextSecondary}"/>

                        <DataGridTemplateColumn Width="58">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Style="{StaticResource DangerIconButton}"
                                            HorizontalAlignment="Center" Click="BtnDeleteMod_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- КАРТОЧКА ИНСПЕКТОРА МОДА -->
            <Border Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. HD-обложка со скруглёнными углами -->
                    <Border Grid.Row="0" Height="168" CornerRadius="10" Background="#141418" BorderBrush="#343442" BorderThickness="1" Margin="0,0,0,12">
                        <Grid>
                            <Border CornerRadius="10">
                                <Border.Background>
                                    <ImageBrush x:Name="ImgInspectorBrush" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border.Background>
                            </Border>

                            <Border CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.4" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#D9111115" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border Background="#E6181820" BorderBrush="#FF6600" BorderThickness="1"
                                    CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                <TextBlock x:Name="TxtInspectorVersionBadge" Text="v—" FontSize="11" FontWeight="Bold" Foreground="#FF8533"/>
                            </Border>

                            <TextBlock x:Name="TxtInspectorTitle" Text="Выберите мод" FontSize="16" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Bottom" Margin="12,0,12,10"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- 2. Цветные бейджи -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                        <Border Background="#262633" BorderBrush="#3B3B4F" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                            <TextBlock x:Name="BadgeCategory" Text="🚗 Авто" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                        <Border Background="#1B2838" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                            <TextBlock x:Name="BadgeSource" Text="📁 Local" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA"/>
                        </Border>
                        <Border x:Name="BadgeStatusBorder" Background="#132A20" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,4">
                            <TextBlock x:Name="BadgeStatus" Text="АКТИВЕН" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                        </Border>
                    </WrapPanel>

                    <!-- 3. Плашки характеристик -->
                    <StackPanel Grid.Row="2">
                        <Border Background="#15151A" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                            <Grid>
                                <TextBlock Text="Автор" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtInspectorAuthor" Text="—" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>

                        <Border Background="#15151A" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                            <Grid>
                                <TextBlock Text="ID в игре" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtInspectorGameId" Text="—" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#FF9838" HorizontalAlignment="Right" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>

                        <Border Background="#15151A" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                            <Grid>
                                <TextBlock Text="Конфигураций" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtInspectorConfigs" Text="—" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#10B981" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border Background="#15151A" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                            <Grid>
                                <TextBlock Text="Размер и дата" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TxtInspectorSizeDate" Text="—" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border Background="#15151A" CornerRadius="8" Padding="10,7">
                            <StackPanel>
                                <TextBlock Text="Имя архива на диске:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtInspectorFile" Text="—" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 4. Кнопки действий -->
                    <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
                        <Button Content="📂 Показать в Проводнике" Style="{StaticResource ModernButton}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6" Click="BtnRevealSelectedMod_Click"/>
                        <Button Content="📦 Открыть .ZIP архив" Style="{StaticResource ModernButton}"
                                HorizontalAlignment="Stretch" Click="BtnOpenZipArchive_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- РЯД 4: Нижняя панель -->
        <Border Grid.Row="4" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnClearCache" Grid.Column="0" Content="🧹 Кэш игры"
                        Style="{StaticResource ModernButton}" Margin="0,0,6,0" Click="BtnClearCache_Click"/>

                <Button Grid.Column="1" Content="🌐 Кэш MP"
                        Style="{StaticResource ModernButton}" Margin="0,0,6,0" Click="BtnCleanBeamMpCache_Click"/>

                <Button x:Name="BtnCheckConflicts" Grid.Column="2" Content="⚡ Конфликты"
                        Style="{StaticResource ModernButton}" Margin="0,0,6,0" Click="BtnCheckConflicts_Click"/>

                <Button Grid.Column="3" Content="🩺 Здоровье"
                        Style="{StaticResource ModernButton}" Margin="0,0,6,0" Click="BtnHealthCheck_Click"/>

                <Button x:Name="BtnCheckUpdates" Grid.Column="4" Content="🔄 Обновления"
                        Style="{StaticResource ModernButton}" Click="BtnCheckUpdates_Click"/>

                <TextBlock x:Name="LblStatus" Grid.Column="5"
                           Text="Перетащите архивы (.zip, .rar, .7z) в любое место окна"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                           Margin="14,0" TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="6" Content="🌐 Запустить BeamMP"
                        Style="{StaticResource ModernButton}" Background="#2563EB" BorderThickness="0"
                        Foreground="White" FontWeight="Bold" Padding="16,10" Margin="0,0,8,0"
                        Click="BtnLaunchBeamMp_Click"/>

                <Button x:Name="BtnLaunchGame" Grid.Column="7" Content="▶ Запустить BeamNG.drive"
                        Style="{StaticResource LaunchGreenButton}" Padding="18,10" Click="BtnLaunchGame_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>